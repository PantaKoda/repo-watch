<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWatch.Desktop.ViewModels"
        x:Class="RepoWatch.Desktop.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="Repo Watch update"
        Width="520" Height="560" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20,12,20,16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="heading" Margin="0,4,0,0" Text="{Binding Heading}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding Summary}" />
    </StackPanel>

    <!-- Actions -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <ProgressBar IsVisible="{Binding ShowProgress}" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="4" MinHeight="4" />
      <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" Text="{Binding InstallHint}" IsVisible="{Binding HasInstallHint}" TextWrapping="Wrap" TextTrimming="None" />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Classes="accent" Content="Install update" Command="{Binding InstallCommand}"
                ToolTip.Tip="Downloads the release from GitHub, checks it against its published checksum, then restarts into the new version. Your settings and sign-in are kept." />
        <Button Content="View on GitHub" Command="{Binding ViewOnGitHubCommand}" />
        <Button Content="Check again" Command="{Binding CheckAgainCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Later" Click="OnLaterClick" />
      </WrapPanel>
    </StackPanel>

    <!-- What changed, newest release first -->
    <Border BorderBrush="{DynamicResource HudFrameBrush}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer Padding="12,8">
        <ItemsControl ItemsSource="{Binding Releases}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReleaseNotesItem">
              <StackPanel Spacing="4" Margin="0,4,0,14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="title" Text="{Binding Title}" />
                  <TextBlock Classes="secondary" Text="{Binding DateText}" VerticalAlignment="Bottom" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
