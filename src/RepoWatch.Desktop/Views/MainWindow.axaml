<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWatch.Desktop.ViewModels"
        x:Class="RepoWatch.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Repo Watch"
        Width="400" SizeToContent="Height" MinWidth="320"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Repo Watch" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Version, StringFormat='Version {0} — development baseline'}" Opacity="0.8" />
    <TextBlock TextWrapping="Wrap"
               Text="The monitoring widget is not implemented yet. This window confirms the application builds, loads configuration and starts." />
    <Separator />
    <TextBlock Text="{Binding SignInStatus}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding RelayStatus}" TextWrapping="Wrap" />
    <SelectableTextBlock Text="{Binding DataDirectory, StringFormat='Data folder: {0}'}" TextWrapping="Wrap" Opacity="0.8" />
  </StackPanel>
</Window>
