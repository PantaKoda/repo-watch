<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWatch.Desktop.ViewModels"
        xmlns:v="using:RepoWatch.Desktop.Views"
        x:Class="RepoWatch.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Repo Watch settings"
        Width="480" Height="600" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="20,8,20,20" Spacing="6">
      <Border IsVisible="{Binding HasStorageProblem}" Background="{DynamicResource DemoBannerBrush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
        <TextBlock Text="{Binding StorageProblem}" TextWrapping="Wrap" Foreground="{DynamicResource DemoBannerForegroundBrush}" />
      </Border>

      <TextBlock Classes="heading" Text="Account" />
      <v:AccountView DataContext="{Binding Account}" />

      <TextBlock Classes="heading" Text="Repositories" />
      <TextBlock TextWrapping="Wrap" Text="{Binding RepositoriesSummary}" />
      <WrapPanel>
        <Button Content="Manage repositories…" Command="{Binding ManageRepositoriesCommand}" Margin="0,0,8,8" />
        <Button Content="Explore demo data" Command="{Binding EnterDemoCommand}" IsVisible="{Binding !IsDemo}" Margin="0,0,8,8" />
        <Button Content="Exit demo" Command="{Binding ExitDemoCommand}" IsVisible="{Binding IsDemo}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock Classes="heading" Text="Widget" />
      <CheckBox Content="Keep the widget above other windows" IsChecked="{Binding AlwaysOnTop}" />
      <CheckBox Content="Lock the widget's position" IsChecked="{Binding PositionLocked}" />
      <TextBlock Text="{Binding TrayDescription}" TextWrapping="Wrap" Classes="secondary" />
      <Button Content="Show widget" Command="{Binding ShowWidgetCommand}" />

      <TextBlock Classes="heading" Text="Appearance" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Text="Theme" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="140"
                  AutomationProperties.Name="Theme" />
        <TextBlock Grid.Row="1" Text="Material" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" MinWidth="140"
                  AutomationProperties.Name="Window material" />
        <TextBlock Grid.Row="2" Text="Background" VerticalAlignment="Center" />
        <DockPanel Grid.Row="2" Grid.Column="1" IsEnabled="{Binding OpacityAdjustable}">
          <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityLabel}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
          <Slider Minimum="{Binding MinOpacityPercent}" Maximum="{Binding MaxOpacityPercent}" Value="{Binding OpacityPercent}"
                  TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                  AutomationProperties.Name="Background opacity" />
        </DockPanel>
        <TextBlock Grid.Row="3" Text="Motion" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MotionChoices}" SelectedItem="{Binding Motion}" MinWidth="140"
                  AutomationProperties.Name="Motion" />
      </Grid>
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Only the widget's background fades; text, icons and menus stay fully opaque. Motion: System follows Windows' animation setting." />
      <TextBlock Text="{Binding VisualStatus}" TextWrapping="Wrap" Classes="secondary" />

      <TextBlock Classes="heading" Text="About" />
      <TextBlock Text="{Binding Version, StringFormat='Repo Watch {0}'}" />
      <SelectableTextBlock Text="{Binding DataDirectory, StringFormat='Data folder: {0}'}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
        <Button Content="Quit Repo Watch" Command="{Binding QuitCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding ActionMessage}" IsVisible="{Binding HasActionMessage}" TextWrapping="Wrap" Classes="secondary" />
    </StackPanel>
  </ScrollViewer>
</Window>
