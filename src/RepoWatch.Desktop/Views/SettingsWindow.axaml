<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWatch.Desktop.ViewModels"
        xmlns:v="using:RepoWatch.Desktop.Views"
        x:Class="RepoWatch.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Repo Watch settings"
        Width="480" Height="600" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="20,8,20,20" Spacing="6">
      <Border IsVisible="{Binding HasStorageProblem}" Background="{DynamicResource DemoBannerBrush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
        <TextBlock Text="{Binding StorageProblem}" TextWrapping="Wrap" Foreground="{DynamicResource DemoBannerForegroundBrush}" />
      </Border>

      <TextBlock Classes="heading" Text="Account" />
      <v:AccountView DataContext="{Binding Account}" />

      <TextBlock Classes="heading" Text="Repositories" />
      <TextBlock TextWrapping="Wrap" Text="{Binding RepositoriesSummary}" />
      <WrapPanel>
        <Button Content="Manage repositories…" Command="{Binding ManageRepositoriesCommand}" Margin="0,0,8,8" />
        <Button Content="Explore demo data" Command="{Binding EnterDemoCommand}" IsVisible="{Binding !IsDemo}" Margin="0,0,8,8" />
        <Button Content="Exit demo" Command="{Binding ExitDemoCommand}" IsVisible="{Binding IsDemo}" Margin="0,0,8,8" />
      </WrapPanel>
      <CheckBox Content="Pause monitoring" IsChecked="{Binding MonitoringPaused}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="While paused, Repo Watch sends no requests to GitHub and shows the last data it had. Also available from the tray menu." />

      <TextBlock Classes="heading" Text="Refresh intervals" />
      <TextBlock TextWrapping="Wrap"
                 Text="How often Repo Watch asks GitHub about each kind of data, in seconds. Shorter is fresher but uses more of your GitHub request allowance; unchanged answers cost nothing." />
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="12" Margin="0,4,0,0">
        <TextBlock Grid.Row="0" Text="Running workflows" VerticalAlignment="Center" FontWeight="SemiBold" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding RunningSeconds}" Minimum="{Binding MinRefreshSeconds}" Maximum="{Binding MaxRefreshSeconds}"
                       Increment="5" FormatString="0" MinWidth="130" AutomationProperties.Name="Running workflows refresh interval in seconds" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                   Text="{Binding DefaultRunningSeconds, StringFormat='Actions while a workflow is queued or running, and the repository whose details are open. Default {0} s.'}" />

        <TextBlock Grid.Row="2" Text="Pull requests and repository details" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PullRequestsSeconds}" Minimum="{Binding MinRefreshSeconds}" Maximum="{Binding MaxRefreshSeconds}"
                       Increment="10" FormatString="0" MinWidth="130" AutomationProperties.Name="Pull requests refresh interval in seconds" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                   Text="{Binding DefaultPullRequestsSeconds, StringFormat='Open pull requests with their checks, reviews and merge state, plus repository details: public or private, renames, archived. Default {0} s.'}" />

        <TextBlock Grid.Row="4" Text="Issues" VerticalAlignment="Center" FontWeight="SemiBold" />
        <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding IssuesSeconds}" Minimum="{Binding MinRefreshSeconds}" Maximum="{Binding MaxRefreshSeconds}"
                       Increment="10" FormatString="0" MinWidth="130" AutomationProperties.Name="Issues refresh interval in seconds" />
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                   Text="{Binding DefaultIssuesSeconds, StringFormat='Open issues and their counts. Default {0} s.'}" />

        <TextBlock Grid.Row="6" Text="Quiet workflows" VerticalAlignment="Center" FontWeight="SemiBold" />
        <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding QuietSeconds}" Minimum="{Binding MinRefreshSeconds}" Maximum="{Binding MaxRefreshSeconds}"
                       Increment="10" FormatString="0" MinWidth="130" AutomationProperties.Name="Quiet workflows refresh interval in seconds" />
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                   Text="{Binding DefaultQuietSeconds, StringFormat='Actions when nothing is running, to notice a new run starting. Default {0} s.'}" />
      </Grid>
      <TextBlock Text="{Binding RefreshHint}" IsVisible="{Binding HasRefreshHint}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" TextTrimming="None"
                 Text="Allowed: 5 to 3600 seconds. Changes are saved a moment after you stop typing. Repo Watch checks less often while the widget is hidden (×3) or on battery (×2), and waits when GitHub asks it to. Bringing the widget to the front always refreshes anything older than 30 seconds, and F5 refreshes everything now." />
      <Button Content="Reset to defaults" Command="{Binding ResetRefreshIntervalsCommand}" IsEnabled="{Binding !RefreshIsDefault}" HorizontalAlignment="Left" />

      <TextBlock Classes="heading" Text="Notifications" />
      <CheckBox Content="Show notifications" IsChecked="{Binding NotificationsEnabled}" />
      <StackPanel Margin="24,0,0,0" Spacing="2" IsEnabled="{Binding NotificationsEnabled}">
        <CheckBox Content="CI starts failing on a tracked branch" IsChecked="{Binding NotifyCiFailure}" />
        <CheckBox Content="CI passes again" IsChecked="{Binding NotifyCiRecovery}" />
        <CheckBox Content="Someone requests my review" IsChecked="{Binding NotifyReviewRequested}" />
        <CheckBox Content="A pull request I track is merged" IsChecked="{Binding NotifyMerged}" />
        <CheckBox Content="Hide private repository names and titles in notifications" IsChecked="{Binding HidePrivateDetails}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <CheckBox Content="Quiet hours from" IsChecked="{Binding QuietHoursEnabled}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietStart}" IsEnabled="{Binding QuietHoursEnabled}" AutomationProperties.Name="Quiet hours start" />
          <TextBlock Text="to" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietEnd}" IsEnabled="{Binding QuietHoursEnabled}" AutomationProperties.Name="Quiet hours end" />
        </StackPanel>
      </StackPanel>
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Each event is announced once. Events during quiet hours, or of a switched-off type, are skipped, not saved for later. Per-repository switches are in Manage repositories." />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding NotificationStatus}" />
      <Button Content="Show a test notification" Command="{Binding TestNotificationCommand}" />

      <TextBlock Classes="heading" Text="Startup" />
      <CheckBox Content="Start Repo Watch when I sign in" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding StartupSupported}" />
      <CheckBox Content="Start minimized to the tray" IsChecked="{Binding StartMinimized}" IsEnabled="{Binding CanStartMinimized}" Margin="24,0,0,0" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding StartupStatus}" />

      <TextBlock Classes="heading" Text="Widget" />
      <CheckBox Content="Keep the widget above other windows" IsChecked="{Binding AlwaysOnTop}" />
      <CheckBox Content="Lock the widget's position" IsChecked="{Binding PositionLocked}" />
      <CheckBox Content="Show/Hide shortcut (Ctrl+Alt+R)" IsChecked="{Binding ShowHideShortcut}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ShortcutStatus}" />
      <TextBlock Text="{Binding TrayDescription}" TextWrapping="Wrap" Classes="secondary" />
      <Button Content="Show widget" Command="{Binding ShowWidgetCommand}" />

      <TextBlock Classes="heading" Text="Appearance" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Text="Theme" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="140"
                  AutomationProperties.Name="Theme" />
        <TextBlock Grid.Row="1" Text="Material" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" MinWidth="140"
                  AutomationProperties.Name="Window material" />
        <TextBlock Grid.Row="2" Text="Background" VerticalAlignment="Center" />
        <DockPanel Grid.Row="2" Grid.Column="1" IsEnabled="{Binding OpacityAdjustable}">
          <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityLabel}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
          <Slider Minimum="{Binding MinOpacityPercent}" Maximum="{Binding MaxOpacityPercent}" Value="{Binding OpacityPercent}"
                  TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                  AutomationProperties.Name="Background opacity" />
        </DockPanel>
        <TextBlock Grid.Row="3" Text="Motion" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MotionChoices}" SelectedItem="{Binding Motion}" MinWidth="140"
                  AutomationProperties.Name="Motion" />
        <TextBlock Grid.Row="4" Text="Accent" VerticalAlignment="Center" />
        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" MinWidth="140"
                  AutomationProperties.Name="Accent" />
        <TextBlock Grid.Row="5" Text="Density" VerticalAlignment="Center" />
        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}" MinWidth="140"
                  AutomationProperties.Name="Density" />
      </Grid>
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Only the widget's background fades; text, icons and menus stay fully opaque. Motion: System follows Windows' animation setting." />
      <TextBlock Text="{Binding VisualStatus}" TextWrapping="Wrap" Classes="secondary" />

      <TextBlock Classes="heading" Text="About" />
      <TextBlock Text="{Binding Version, StringFormat='Repo Watch {0}'}" />
      <SelectableTextBlock Text="{Binding DataDirectory, StringFormat='Data folder: {0}'}" TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding CanCheckForUpdates}"
                ToolTip.Tip="Opens the releases page in your browser. Repo Watch never downloads or installs updates by itself." />
        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
        <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" IsVisible="{Binding CanExportDiagnostics}" />
        <Button Content="Quit Repo Watch" Command="{Binding QuitCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding ActionMessage}" IsVisible="{Binding HasActionMessage}" TextWrapping="Wrap" Classes="secondary" />
    </StackPanel>
  </ScrollViewer>
</Window>
