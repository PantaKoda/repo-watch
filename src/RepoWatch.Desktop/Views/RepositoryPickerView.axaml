<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RepoWatch.Desktop.ViewModels"
             x:Class="RepoWatch.Desktop.Views.RepositoryPickerView"
             x:DataType="vm:RepositoryPickerViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
      <TextBox PlaceholderText="Search repositories" Text="{Binding SearchText}" AutomationProperties.Name="Search repositories" />
      <WrapPanel>
        <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding OwnerFilter}" MinWidth="160" Margin="0,0,8,6"
                  AutomationProperties.Name="Owner or organization" />
        <ToggleButton Content="Show selected" IsChecked="{Binding ShowSelectedOnly}" Margin="0,0,8,6" />
        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,6" />
        <Button Content="Refresh list" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,6" />
      </WrapPanel>
      <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ShownText}" Classes="secondary" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="secondary" IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
      <TextBlock Text="{Binding BulkScopeText}" Classes="secondary" TextWrapping="Wrap" />
      <WrapPanel>
        <Button Content="{Binding AddShownLabel}" Command="{Binding AddShownCommand}" IsEnabled="{Binding CanAddShown}" Margin="0,0,8,6" />
        <Button Content="{Binding RemoveShownLabel}" Command="{Binding RemoveShownCommand}" IsEnabled="{Binding CanRemoveShown}" Margin="0,0,8,6" />
      </WrapPanel>
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Selecting a repository only adds it to this widget. It never changes what Repo Watch may access on GitHub." />
    </StackPanel>

    <Panel>
      <StackPanel IsVisible="{Binding ShowGrantAccess}" Spacing="8" VerticalAlignment="Center" Margin="8">
        <TextBlock Text="Repo Watch hasn't been granted access to any repositories yet." FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Text="Install it on your account or organization and choose repositories on GitHub, then refresh this list." />
        <Button Content="Grant access on GitHub" Classes="accent" Command="{Binding GrantAccessCommand}" />
      </StackPanel>
      <TextBlock IsVisible="{Binding ShowEmpty}" Text="{Binding EmptyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8" />
      <ListBox ItemsSource="{Binding Shown}" Background="Transparent" AutomationProperties.Name="Repositories you can watch">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RepositoryChoiceViewModel">
            <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding FullName}">
              <StackPanel>
                <TextBlock Classes="title" Text="{Binding FullName}" />
                <TextBlock Classes="secondary" Text="{Binding Badges}" />
                <TextBlock Classes="secondary" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
