<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RepoWatch.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#1A7F37" />
          <SolidColorBrush x:Key="StatusFailureBrush" Color="#CF222E" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#9A6700" />
          <SolidColorBrush x:Key="StatusRunningBrush" Color="#0969DA" />
          <SolidColorBrush x:Key="StatusNeutralBrush" Color="#6E7781" />
          <SolidColorBrush x:Key="StatusUnknownBrush" Color="#6E7781" />
          <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#F6F8FA" />
          <SolidColorBrush x:Key="WidgetBorderBrush" Color="#D0D7DE" />
          <SolidColorBrush x:Key="DemoBannerBrush" Color="#FFF3C4" />
          <SolidColorBrush x:Key="DemoBannerForegroundBrush" Color="#4D3800" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#3FB950" />
          <SolidColorBrush x:Key="StatusFailureBrush" Color="#F85149" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#D29922" />
          <SolidColorBrush x:Key="StatusRunningBrush" Color="#58A6FF" />
          <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8B949E" />
          <SolidColorBrush x:Key="StatusUnknownBrush" Color="#8B949E" />
          <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#161B22" />
          <SolidColorBrush x:Key="WidgetBorderBrush" Color="#30363D" />
          <SolidColorBrush x:Key="DemoBannerBrush" Color="#3B2F00" />
          <SolidColorBrush x:Key="DemoBannerForegroundBrush" Color="#F2D675" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Icon geometries from Material Design Icons (Apache License 2.0). -->
      <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.61l-1.92-3.32a.5.5 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54A.48.48 0 0 0 13.92 2h-3.84a.48.48 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.73 8.47a.48.48 0 0 0 .12.61l2.03 1.58c-.05.3-.08.63-.08.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z</StreamGeometry>
      <StreamGeometry x:Key="IconExpand">M12 5.83 15.17 9l1.41-1.41L12 3 7.41 7.59 8.83 9 12 5.83zm0 12.34L8.83 15l-1.41 1.41L12 21l4.59-4.59L15.17 15 12 18.17z</StreamGeometry>
      <StreamGeometry x:Key="IconCollapse">M7.41 18.59 8.83 20 12 16.83 15.17 20l1.41-1.41L12 14l-4.59 4.59zm9.18-13.18L15.17 4 12 7.17 8.83 4 7.41 5.41 12 10l4.59-4.59z</StreamGeometry>
      <StreamGeometry x:Key="IconMinimize">M6 11h12v2H6z</StreamGeometry>
      <StreamGeometry x:Key="IconOpenExternal">M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zm5 16H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7z</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Compact icon-only buttons; each has a tooltip and an accessible name. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>

    <!-- Full-width list rows that open GitHub. -->
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="TextBlock.secondary">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </Application.Styles>
</Application>
